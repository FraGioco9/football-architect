# Generated static app pages must retain canonical LF line endings on Windows.
dashboard/index.html text eol=lf
calendar/index.html text eol=lf
settings/index.html text eol=lf
competitions/**/index.html text eol=lf
competitions/index.html text eol=lf
competitions/_shared/manifest.json text eol=lf
templates/app-page.html text eol=lf
# Preserve the approved CSV fingerprint in Windows checkouts.
data/clubs-registry.csv text eol=lf
# Inline flag markup must be deterministic across Windows and Unix checkouts.
assets/flags/*.svg text eol=lf
# Approved SVG integrity is computed over original bytes; never convert them.
assets/divisions/**/*.svg -text
# Preserve uploaded club crest artwork bytes on every platform.
assets/clubs/**/*.svg -text

clubs/_shared/index.html text eol=lf
clubs/_shared/manifest.json text eol=lf

# Season 1 review pins raw canonical source bytes across Windows/Unix checkouts.
data/clubs.json text eol=lf
data/divisions.json text eol=lf
data/international-competitions.json text eol=lf
backend/catalogues/season-1.participants.json text eol=lf
assets/world-calendar-model.js text eol=lf
