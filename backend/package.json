{
  "name": "football-architect-admin-world",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --local",
    "test:contracts": "node tools/run-contracts.mjs",
    "test:operator": "node --experimental-strip-types --test tests/operator-local.test.mts tests/worker-restart.test.mts tests/prepare-persistence.test.mts tests/production-bundle.test.mts tests/season-one-candidate.test.mts tests/owner-permissions-local.test.mts",
    "admin:account": "node --experimental-strip-types tools/admin-account.mts",
    "catalogue:check": "node --experimental-strip-types tools/season-one-candidate.mts --check",
    "test:auth-local": "vitest run tests/player-auth-runtime.test.ts tests/player-registration-runtime.test.ts tests/player-password-reset-runtime.test.ts tests/admin-operator-migration-runtime.test.ts",
    "admin:permissions": "node --experimental-strip-types tools/admin-permissions.mts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@types/node": "22.18.6",
    "miniflare": "5.20261023.0-beta",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.153.0"
  },
  "dependencies": {
    "argon2id": "1.0.1"
  }
}
