    "source_url": "https://www.wikidata.org/",
    "source_country_qid": "Q912",
    "source_country": "Mali",
    "source_sparql": "PREFIX wd: <http://www.wikidata.org/entity/>\n  PREFIX wdt: <http://www.wikidata.org/prop/direct/>\n  PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n  SELECT ?given ?label ?n WHERE {\n  { SELECT ?given (COUNT(DISTINCT ?person) AS ?n) WHERE {\n     ?person wdt:P21 wd:Q6581097 ;\n             wdt:P735 ?given .\n     { ?person wdt:P27 wd:Q912 . } UNION { ?person wdt:P19 ?birthplace . ?birthplace wdt:P17 wd:Q912 . }\n  } GROUP BY ?given ORDER BY DESC(?n) LIMIT 5000 }\n  ?given rdfs:label ?label .\n  FILTER(LANG(?label) IN (\"en\",\"fr\"))\n} ORDER BY DESC(?n)",
    "source_response_sha256": "4de4db174a31ced2a332623ce9c644b2f034eb11e20f6be938d6e0dde1571b9d",
    "source_rows": 582,
    "eligible_unique_names": 300,
    "metric": "count of distinct male Wikidata people who are citizens of Mali or documented as born in a place located in Mali; Wikidata entity counts, not census or births",
    "license": "Wikidata structured data CC0; QLever is the SPARQL query service, not a separate population registry",
    "source_scope": "union of country of citizenship P27 Mali and country of birth place P19/P17 Mali, deduplicated per person",
    "source_query_endpoint": "https://qlever.dev/api/wikidata",
    "source_languages": [
      "en",
      "fr"
    ],
    "source_observed_date": "2026-11-06"
